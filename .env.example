# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Neo4j Configuration
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=chandan01245
NEO4J_TIMEOUT=30

# Groq API Configuration (Optional - leave empty to use regex-based extraction)
# If you have a Groq API key, add it here. Otherwise, leave it empty.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2000
GROQ_MAX_RETRIES=3
GROQ_TIMEOUT=60

# Pipeline Configuration
CHUNK_SIZE=1024
CHUNK_OVERLAP=200
BATCH_SIZE=100
CONFIG_ENV=development

# Logging Configuration
LOG_LEVEL=INFO
DEBUG=False
